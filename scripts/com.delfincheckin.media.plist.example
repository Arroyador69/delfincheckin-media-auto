<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.delfincheckin.media</string>
  <key>WorkingDirectory</key>
  <string>/Users/TU_USUARIO/delfincheckin-media-auto</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/TU_USUARIO/delfincheckin-media-auto/.venv/bin/python</string>
    <string>-m</string>
    <string>delfin_media</string>
    <string>generate</string>
    <string>--count</string>
    <string>3</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/TU_USUARIO/delfincheckin-media-auto/output/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/TU_USUARIO/delfincheckin-media-auto/output/logs/launchd.err.log</string>
</dict>
</plist>
