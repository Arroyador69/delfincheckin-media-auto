# Opcional. El sistema funciona sin esto (guiones de plantilla).
# GEMINI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral

# Azure Speech (Dragon HD, acento España). Copia este archivo a .env
# AZURE_SPEECH_KEY=pega_aqui_la_clave_1
# AZURE_SPEECH_REGION=westeurope

# TikTok (Sandbox de developers.tiktok.com). No uses Production todavía.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://social.delfincheckin.com/oauth/tiktok

# Postiz (buffer IG/FB/YT/TikTok en el Mac Mini). Ver scripts/postiz.compose.example.yml
# POSTIZ_URL=https://social.delfincheckin.com
# POSTIZ_API_KEY=

# Meta (Instagram + Facebook) — ya las tienes; se usarán en Postiz en el Mac Mini
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# YouTube — ya la tienes; se usará en Postiz / upload
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
